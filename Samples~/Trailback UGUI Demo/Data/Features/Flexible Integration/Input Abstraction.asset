  m_Script: {fileID: 11500000, guid: 98791389b7d380b4395ab6a364f1847c, type: 3}
  m_Name: Input Abstraction
  m_EditorClassIdentifier: Assembly-CSharp::Trailback.Demo.Features.Data.FeatureDemoData
  featureName: Input Abstraction
  shortDescription: Support multiple input systems through a unified workflow.
  fullDescription: "Trailback doesn't depend on a specific input system. Instead,
    it receives back navigation requests through the BackInputSource abstraction.\n\nWhether
    your project uses Unity's Legacy Input Manager, the Unity Input System, VR controllers,
    touch input, or a custom solution, the integration follows the same pattern:
    detect a back action, raise the BackRequested event, and let the rest of the
    navigation flow continue as normal.\n\nFeatures include:\n\n\u2022 BackInputSource
    Abstraction\n\u2022 Legacy Input Support\n\u2022 Unity Input System Support\n\u2022
    Custom Input Providers\n\nBy separating input detection from navigation, Trailback
    can integrate naturally into a wide range of Unity projects without being tied
    to a particular input framework."
  screenshots: []
  videoUrl: 
  documentationUrl: https://github.com/akpardeshi/Trailback/blob/main/Documentation/Guides/Features.md#input-abstraction
