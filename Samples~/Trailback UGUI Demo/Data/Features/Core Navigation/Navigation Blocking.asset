  m_Script: {fileID: 11500000, guid: 98791389b7d380b4395ab6a364f1847c, type: 3}
  m_Name: Navigation Blocking
  m_EditorClassIdentifier: Assembly-CSharp::Trailback.Demo.Features.Data.FeatureDemoData
  featureName: Navigation Blocking
  shortDescription: Temporarily prevent Back navigation during critical workflows.
  fullDescription: "Navigation Blocking lets your application temporarily prevent
    Back navigation while the user completes an important task.\n\nThis is useful
    for workflows that shouldn't be interrupted, such as confirmation dialogs, unsaved
    changes, loading operations, or other situations where leaving the current screen
    too early could cause problems.\n\nFeatures include:\n\n\u2022 Temporary Navigation
    Blocking\n\u2022 Confirmation Dialog Support\n\u2022 Workflow Protection\n\u2022
    Explicit Navigation Control\n\nOnce your application allows navigation again,
    Trailback continues processing Back requests as usual."
  screenshots: []
  videoUrl: 
  documentationUrl: https://github.com/akpardeshi/Trailback/blob/main/Documentation/Guides/Features.md#navigation-blocking
