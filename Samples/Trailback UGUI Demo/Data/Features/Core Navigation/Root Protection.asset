  m_Script: {fileID: 11500000, guid: 98791389b7d380b4395ab6a364f1847c, type: 3}
  m_Name: Root Protection
  m_EditorClassIdentifier: Assembly-CSharp::Trailback.Demo.Features.Data.FeatureDemoData
  featureName: Root Protection
  shortDescription: Prevent important navigation roots from being consumed.
  fullDescription: "Root Protection keeps the last navigation entry in a category
    from being removed when the user reaches the beginning of the navigation flow.\n\nInstead
    of navigating past the root, Trailback raises the Navigation Root Reached event,
    giving your application the opportunity to decide what happens next. For example,
    you might show an exit confirmation dialog, return to a main menu, or close the
    application.\n\nFeatures include:\n\n\u2022 Protected Root Elements\n\u2022 Navigation
    Root Reached Events\n\u2022 Per-Category Configuration\n\u2022 Predictable Back
    Navigation\n\nRoot Protection helps ensure that important screens, such as a
    Home Screen or Main Menu, remain available as the foundation of your application's
    navigation flow."
  screenshots: []
  videoUrl: 
  documentationUrl: https://github.com/akpardeshi/Trailback/blob/main/Documentation/Guides/Features.md#root-protection
  featureStatus: 0
  featureVersion:
    Major: 1
    Minor: 0
    Patch: 0
  featureImportance: 0
